#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
PROG=/usr/sbin/uhttpd

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" -f \
        -p 127.0.0.1:50080 \
        -h /etc/ip-approve/quick \
        -x /cgi-bin \
        -T 60 -t 10
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
