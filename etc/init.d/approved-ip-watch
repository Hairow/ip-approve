#!/bin/sh /etc/rc.common
# approved-ip-watch: 待审批IP监听推送服务
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /etc/ip-approve/approved-ip-watch.sh
    procd_set_param env APPROVE_WATCH_SVC=1
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
