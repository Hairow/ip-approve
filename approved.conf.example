# /etc/ip-approve/approved.conf 配置模板
# 复制到路由器 /etc/ip-approve/approved.conf 后按实际值填写
# 权限应为 600（含密钥）

# 钉钉机器人 webhook（access_token 为 hex，DING_SECRET 为 SEC 开头加签密钥）
DING_WEBHOOK='https://oapi.dingtalk.com/robot/send?access_token=<hex-token>'
DING_SECRET='SECxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# ---- input 审批组（外网 -> 路由器本机，规则 ip4-*/ip6-* 各 4 条）----
# 空格分隔；留空 = 该协议族不创建审批规则，流量走 wan 兜底拒绝（不审批）
INPUT_APPROVE_PORT4='50000 56680 30080'
INPUT_APPROVE_PORT6='56666 56667 30080'

# ---- forward 审批组（外网 -> lan 转发流量，规则 forward-ip4-*/forward-ip6-* 各 4 条）----
# 注意：forward 规则只按端口匹配、不限定目标主机，端口应只给单一目标服务使用（如 fnOS Web）
FORWARD_APPROVE_PORT4=''
FORWARD_APPROVE_PORT6='5666 5667'

# 钉钉一键审批（留空则推送退回纯文本，无按钮）
# QUICK_SECRET: 32 位 hex，watch 算签名与 CGI 验签必须一致
# QUICK_URL: 公网入口域名（Tailscale Funnel），如 https://<设备名>.<tailnet>.ts.net
QUICK_SECRET='<32位hex>'
QUICK_URL='https://istoreos.tailaf168e.ts.net'
