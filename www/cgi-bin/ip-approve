#!/bin/sh
# /www/cgi-bin/ip-approve — IP 审批接口（复用 LuCI 会话鉴权）
# 用法1（CLI 自测，控制器调用，支持批量）：
#   IPAPPROVE_SELFTEST=1 本脚本 approve ip1 [ip2 ...]
# 用法2（HTTP GET 兼容，单个）：?action=list|approve|deny&ip=<地址>
# 自测模式跳过鉴权；LuCI 控制器负责会话校验与参数校验

CN=/etc/ip-approve
PIDF_LOCK=/tmp/.pending.lock
LOG=/tmp/.ipap-cgi.log
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

# 诊断日志：仅追加到文件，不影响 JSON 响应；排查后可移除
dbg() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

# 获取 fd 9 上的锁：非阻塞重试约 5 秒，避免瞬时抢锁直接失败；超时返回 1
take_lock() {
    local n=0
    while [ "$n" -lt 25 ]; do
        flock -n 9 && return 0
        n=$((n+1)); sleep 0.2
    done
    return 1
}

json_out() {
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s' "$1"
}

fail() { json_out "{\"ok\":false,\"error\":\"$1\"}"; exit 0; }

. "$CN/ip-address.sh" || fail "ip-validator-unavailable"
TMP_DIR=$(mktemp -d "$CN/.cgi.XXXXXX") || fail "temp-dir-failed"
trap 'rm -rf "$TMP_DIR"' 0
trap 'exit 1' HUP INT TERM

# 字符串进 JSON 前转义反斜杠与双引号
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# 写动作仅限 POST：GET 触发返回 405，避免跨站简单请求 CSRF
method_not_allowed() {
    printf 'Status: 405 Method Not Allowed\r\nContent-Type: application/json\r\nAllow: POST\r\nCache-Control: no-store\r\n\r\n{"ok":false,"error":"method-not-allowed"}'
    exit 0
}

# ---- 鉴权（HTTP 模式才走）----
check_auth() {
    local sid out
    sid=$(printf '%s' "$HTTP_COOKIE" | tr ';' '\n' | sed -n 's/^ *sysauth=\([^ ;]*\).*/\1/p')
    [ -n "$sid" ] || return 1
    ubus call session get "{\"ubus_rpc_session\":\"$sid\"}" >/dev/null 2>&1
}

# v6 单地址聚合为 /64 前缀（前 64 位）；非 v6 原样返回。
# 白名单按 /64 放行，规避 IPv6 临时隐私地址轮换后重复进待审批；deny 不调用本函数。
v6_64() {
    local ip6
    case "$1" in
        *:*)
            ip6=$(ip6_hex_tail "${1%/*}") || return 1
            printf '%s' "$ip6" | awk '
            function norm(s,  n,a,i,l,r,left,right,L,R,k,gap,segs,out) {
                sub(/\/.*/, "", s)
                n = split(s, a, ":")
                delete L; delete R; l = 0; r = 0
                if (index(s, "::") > 0) {
                    left = substr(s, 1, index(s, "::") - 1)
                    right = substr(s, index(s, "::") + 2)
                    if (left != "") l = split(left, L, ":")
                    if (right != "") r = split(right, R, ":")
                    gap = 8 - l - r; k = 0
                    for (i = 1; i <= l; i++) { if (L[i] != "") L[++k] = L[i] }
                    l = k
                    delete segs; k = 0
                    for (i = 1; i <= l; i++) segs[++k] = L[i]
                    for (i = 1; i <= gap; i++) segs[++k] = "0"
                    for (i = 1; i <= r; i++) segs[++k] = R[i]
                } else {
                    for (i = 1; i <= n; i++) segs[i] = a[i]
                }
                out = segs[1]
                for (i = 2; i <= 4; i++) out = out ":" segs[i]
                print out "::/64"
            }
            { norm($0) }'
            ;;
        *) printf '%s' "$1" ;;
    esac
}

# ---- 失败明细（JSON 拼接）----
FAILED_JSON="["
FAILED_N=0
fail_add() {  # $1=ip $2=error
    [ $FAILED_N = 0 ] || FAILED_JSON="$FAILED_JSON,"
    FAILED_JSON="$FAILED_JSON{\"ip\":\"$1\",\"error\":\"$2\"}"
    FAILED_N=$((FAILED_N+1))
}

# ---- 动作 ----
action_list() {
    local rows="[" first=1 ip a b c rest ts port geo
    # pending.list 行格式：ip 日期 钟点 端口 [归属地]（时间含空格；归属地在端口之后，可含空格）
    while read -r ip a b c rest; do
        [ -n "$ip" ] || continue
        ts="$a $b"
        port="$c"
        case "$port" in *[!0-9]*|'') port="-";; esac
        geo="$rest"
        [ $first = 1 ] && first=0 || rows="$rows,"
        rows="$rows{\"ip\":\"$ip\",\"time\":\"$ts\",\"port\":\"$port\",\"geo\":\"$(json_escape "$geo")\"}"
    done < "$CN/pending.list"
    rows="$rows]"
    json_out "{\"ok\":true,\"rows\":$rows}"
    exit 0
}

# 通用名单读取：$1=v4 文件 $2=v6 文件；注释 `# <ip> <geo>` 关联归属地，
# 文件头独立注释不计入；结果拼到外层 rows / first 变量
read_namelist() {
    local f4="$1" f6="$2" fam f line cur_ip cur_geo
    for fam in v4 v6; do
        [ "$fam" = v4 ] && f="$f4" || f="$f6"
        cur_ip=""; cur_geo=""
        flush_row() {
            [ -n "$cur_ip" ] || return 0
            [ $first = 1 ] && first=0 || rows="$rows,"
            rows="$rows{\"ip\":\"$cur_ip\",\"family\":\"$fam\",\"geo\":\"$(json_escape "$cur_geo")\"}"
            cur_ip=""; cur_geo=""
        }
        while read -r line; do
            [ -n "$line" ] || continue
            case "$line" in
                \#*|';'*)
                    if [ -n "$cur_ip" ]; then
                        # 去掉前导 # 后，仅当首字段是合法条目才视为 `# <ip> <geo>` 注释；
                        # 否则是文件头/分组注释（如 # lan），保留已有归属地不覆盖
                        rest=${line#\#}; rest=${rest# }
                        set -- $rest
                        if [ $# -ge 1 ] && valid_entry "$1"; then
                            shift
                            cur_geo=$*
                        fi
                    fi
                    ;;
                *) flush_row; cur_ip="$line" ;;
            esac
        done < "$f" 2>/dev/null
        flush_row
    done
}

# 黑名单列表：读 ip-deny.list(v4) + ip-deny6.list(v6)
action_denylist() {
    local rows="[" first=1
    read_namelist "$CN/ip-deny.list" "$CN/ip-deny6.list"
    rows="$rows]"
    json_out "{\"ok\":true,\"rows\":$rows}"
    exit 0
}

# 白名单列表：读 ip-allow.list(v4) + ip-allow6.list(v6)
action_allowlist() {
    local rows="[" first=1
    read_namelist "$CN/ip-allow.list" "$CN/ip-allow6.list"
    rows="$rows]"
    json_out "{\"ok\":true,\"rows\":$rows}"
    exit 0
}

# 通用名单移除（支持批量）：入口已吃掉 action，参数为 IP/CIDR 列表。
# 调用前设置全局：RM_F4/RM_F6 名单文件，RM_SET4/RM_SET6 nft 集合，RM_MISS 未命中错误码，RM_ACT 动作名
action_remove() {
    local ok4="" ok6="" ip
    dbg "remove enter act=$RM_ACT ips=$*"
    for ip in "$@"; do
        case "$ip" in
            *:*) if valid_entry "$ip"; then ok6="$ok6 $ip"; else fail_add "$ip" "bad-entry"; fi;;
            *)   if valid_entry "$ip"; then ok4="$ok4 $ip"; else fail_add "$ip" "bad-entry"; fi;;
        esac
    done
    local okips="${ok4# }"
    [ -n "${ok6# }" ] && okips="${okips:+$okips }${ok6# }"
    [ -n "$okips" ] || fail "no-valid-entry"

    # flock 内原子更新两份名单；done 记入参（回显/校验），hit 记集合真实元素（删 nft 用）
    rm -f "$TMP_DIR/ipap.rm.done" "$TMP_DIR/ipap.rm.hit" "$TMP_DIR/ipap.rm.lockrc"
    (
        take_lock || { dbg "remove LOCK-BUSY act=$RM_ACT"; exit 1; }
        : > "$TMP_DIR/ipap.rm.done"
        : > "$TMP_DIR/ipap.rm.hit"
        for ip in $ok4; do
            if grep -qxF "$ip" "$RM_F4" 2>/dev/null; then
                dbg "remove hit v4 $ip"
                echo "$ip" >> "$TMP_DIR/ipap.rm.done"
                echo "$ip" >> "$TMP_DIR/ipap.rm.hit"
                # 同时删正文行与对应的 `# <ip> <geo>` 注释行
                cp -p "$RM_F4" "$TMP_DIR/rm4.new" || exit 1
                awk -v ip="$ip" '$1 == ip { next } /^#/ && $2 == ip { next } { print }' \
                    "$RM_F4" > "$TMP_DIR/rm4.new" 2>/dev/null || exit 1
                mv "$TMP_DIR/rm4.new" "$RM_F4" || exit 1
            else
                dbg "remove miss v4 $ip"
            fi
        done
        for ip in $ok6; do
            hit=""
            if grep -qxF "$ip" "$RM_F6" 2>/dev/null; then
                hit="$ip"
            elif [ "$RM_ACT" = "unallow" ]; then
                # 白名单条目可能是 /64 网段：传单 IP 时聚合后再匹配
                pref=$(v6_64 "$ip")
                grep -qxF "$pref" "$RM_F6" 2>/dev/null && hit="$pref"
            fi
            if [ -n "$hit" ]; then
                dbg "remove hit v6 $hit"
                echo "$ip" >> "$TMP_DIR/ipap.rm.done"
                echo "$hit" >> "$TMP_DIR/ipap.rm.hit"
                cp -p "$RM_F6" "$TMP_DIR/rm6.new" || exit 1
                awk -v ip="$hit" '$1 == ip { next } /^#/ && $2 == ip { next } { print }' \
                    "$RM_F6" > "$TMP_DIR/rm6.new" 2>/dev/null || exit 1
                mv "$TMP_DIR/rm6.new" "$RM_F6" || exit 1
            else
                dbg "remove miss v6 $ip"
            fi
        done
        echo ok > "$TMP_DIR/ipap.rm.lockrc"
    ) 9>"$PIDF_LOCK"

    [ -f "$TMP_DIR/ipap.rm.lockrc" ] || { dbg "remove OP-FAILED act=$RM_ACT ips=$okips"; fail "op-failed"; }

    # 未命中的报对应错误码
    local done_ips="" h4="" h6=""
    for ip in $(cat "$TMP_DIR/ipap.rm.done" 2>/dev/null); do done_ips="$done_ips $ip"; done
    done_ips="${done_ips# }"
    for ip in $okips; do
        case " $done_ips " in
            *" $ip "*) ;;
            *) fail_add "$ip" "$RM_MISS";;
        esac
    done
    for ip in $done_ips; do
        case "$ip" in
            *:*) ;;
            *)   h4="${h4:+$h4, }$ip";;
        esac
    done
    # nft 删除用集合真实元素（v6 白名单可能是 /64 网段）
    for el in $(cat "$TMP_DIR/ipap.rm.hit" 2>/dev/null); do
        case "$el" in
            *:*) h6="${h6:+$h6, }$el";;
            *)   h4="${h4:+$h4, }$el";;
        esac
    done

    # 即时从 nft set 删元素，再后台同步文件与集合
    [ -n "$h4" ] && nft delete element inet fw4 "$RM_SET4" "{ $h4 }" >/dev/null 2>&1
    [ -n "$h6" ] && nft delete element inet fw4 "$RM_SET6" "{ $h6 }" >/dev/null 2>&1
    ( fw4 reload-sets >/dev/null 2>&1 & )

    local dj="[" df=1
    for ip in $done_ips; do [ $df = 1 ] && df=0 || dj="$dj,"; dj="$dj\"$ip\""; done
    dj="$dj]"
    FAILED_JSON="$FAILED_JSON]"
    dbg "remove result act=$RM_ACT done=[$done_ips] failed=$FAILED_JSON"
    json_out "{\"ok\":true,\"action\":\"$RM_ACT\",\"done\":$dj,\"failed\":$FAILED_JSON}"
    exit 0
}

# 从黑名单移除
action_unban() {
    RM_F4="$CN/ip-deny.list";  RM_F6="$CN/ip-deny6.list"
    RM_SET4=ip_deny;           RM_SET6=ip_deny6
    RM_MISS=not-in-denylist;   RM_ACT=unban
    action_remove "$@"
}

# 从白名单移除
action_unallow() {
    RM_F4="$CN/ip-allow.list";  RM_F6="$CN/ip-allow6.list"
    RM_SET4=ip_allow;          RM_SET6=ip_allow6
    RM_MISS=not-in-allowlist;  RM_ACT=unallow
    action_remove "$@"
}

# 审批/拒绝（支持批量）：$1=approve|deny，其余为 IP
action_set() {
    local act="$1"; shift
    local base listfile listfile6
    case "$act" in
        approve) base="ip_allow"; listfile="$CN/ip-allow.list";  listfile6="$CN/ip-allow6.list";;
        deny)    base="ip_deny";  listfile="$CN/ip-deny.list";   listfile6="$CN/ip-deny6.list";;
        *) fail "bad action";;
    esac

    # 1. 校验并按 v4/v6 分类
    local ok4="" ok6="" ip
    for ip in "$@"; do
        case "$ip" in
            *:*) if valid_ip6 "$ip"; then ok6="$ok6 $ip"; else fail_add "$ip" "bad-ip"; fi;;
            *)   if valid_ip4 "$ip"; then ok4="$ok4 $ip"; else fail_add "$ip" "bad-ip"; fi;;
        esac
    done
    local okips="${ok4# }"
    [ -n "${ok6# }" ] && okips="${okips:+$okips }${ok6# }"
    [ -n "$okips" ] || fail "no-valid-ip"

    # 2. flock 内原子更新底账：从 pending.list 移除命中的，记录 done/miss
    rm -f "$TMP_DIR/ipap.done" "$TMP_DIR/ipap.geo" "$TMP_DIR/ipap.lockrc"
    (
        take_lock || exit 1
        : > "$TMP_DIR/ipap.done"
        : > "$TMP_DIR/ipap.geo"
        cp -p "$CN/pending.list" "$TMP_DIR/pending.new" || exit 1
        awk -v ok="$okips" -v done_file="$TMP_DIR/ipap.done" -v geo_file="$TMP_DIR/ipap.geo" '
            BEGIN{n=split(ok,tmp," ");for(i=1;i<=n;i++)ex[tmp[i]]=1}
            $1 in ex {
                print $1 > done_file
                geo=""
                for(i=5;i<=NF;i++) geo=(geo==""?$i:geo" "$i)
                print $1"\t"geo > geo_file
                next
            }
            { print }
        ' "$CN/pending.list" > "$TMP_DIR/pending.new" || exit 1
        mv "$TMP_DIR/pending.new" "$CN/pending.list" || exit 1
        # 写入名单：纯 IP 一行；归属地以 `# <ip> <geo>` 注释行紧随其后（loadfile 与列表展示均跳过注释）
        for ip in $ok4; do
            grep -qxF "$ip" "$listfile" 2>/dev/null && continue
            echo "$ip" >> "$listfile"
            g=$(awk -v ip="$ip" '$1==ip{sub(/^[^\t]*\t/,"");print}' "$TMP_DIR/ipap.geo" 2>/dev/null)
            [ -n "$g" ] && echo "# $ip $g" >> "$listfile"
        done
        for ip in $ok6; do
            # 批准：v6 聚合到 /64 写白名单；拒绝：保持单地址（避免 /64 误杀同子网其他设备）
            if [ "$act" = "approve" ]; then entry=$(v6_64 "$ip"); else entry="$ip"; fi
            grep -qxF "$entry" "$listfile6" 2>/dev/null && continue
            echo "$entry" >> "$listfile6"
            g=$(awk -v ip="$ip" '$1==ip{sub(/^[^\t]*\t/,"");print}' "$TMP_DIR/ipap.geo" 2>/dev/null)
            [ -n "$g" ] && echo "# $entry $g" >> "$listfile6"
        done
        echo ok > "$TMP_DIR/ipap.lockrc"
    ) 9>"$PIDF_LOCK"

    [ -f "$TMP_DIR/ipap.lockrc" ] || fail "op-failed"

    # 3. 区分成功/未命中
    local done_ips="" e4="" e6="" p4="" p6=""
    for ip in $(cat "$TMP_DIR/ipap.done" 2>/dev/null); do done_ips="$done_ips $ip"; done
    done_ips="${done_ips# }"
    for ip in $okips; do
        case " $done_ips " in
            *" $ip "*) ;;
            *) fail_add "$ip" "not-in-pending";;
        esac
    done
    for ip in $done_ips; do
        case "$ip" in
            *:*)
                if [ "$act" = "approve" ]; then e6="${e6:+$e6, }$(v6_64 "$ip")"; else e6="${e6:+$e6, }$ip"; fi
                p6="${p6:+$p6, }$ip";;
            *)   e4="${e4:+$e4, }$ip"; p4="${p4:+$p4, }$ip";;
        esac
    done

    # 4. 即时生效：整批一次 nft；fw4 reload-sets 放后台同步文件与集合
    [ -n "$e4" ] && nft add element inet fw4 "$base"      "{ $e4 }" >/dev/null 2>&1
    [ -n "$e6" ] && nft add element inet fw4 "${base}6"   "{ $e6 }" >/dev/null 2>&1
    [ -n "$p4" ] && nft delete element inet fw4 ip_pending  "{ $p4 }" >/dev/null 2>&1
    [ -n "$p6" ] && nft delete element inet fw4 ip_pending6 "{ $p6 }" >/dev/null 2>&1
    ( fw4 reload-sets >/dev/null 2>&1 & )

    # 5. 输出结果
    local dj="[" df=1
    for ip in $done_ips; do [ $df = 1 ] && df=0 || dj="$dj,"; dj="$dj\"$ip\""; done
    dj="$dj]"
    FAILED_JSON="$FAILED_JSON]"
    json_out "{\"ok\":true,\"action\":\"$act\",\"done\":$dj,\"failed\":$FAILED_JSON}"
    exit 0
}

# ---- 入口 ----
if [ -n "$IPAPPROVE_SELFTEST" ]; then
    ACTION="$1"; shift
    dbg "cgi enter selftest action=$ACTION ips=$*"
else
    case "$REQUEST_METHOD" in
        GET|POST) ;;
        *) fail "bad method";;
    esac
    check_auth || fail "unauthorized"
    ACTION=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*action=\([a-z]*\).*/\1/p')
    IP=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*[?&]ip=\([0-9a-fA-F:.]*\).*/\1/p')
    # list/denylist/allowlist 为只读可走 GET；approve/deny/unban/unallow 为写动作，仅允许 POST
    case "$ACTION" in
        approve|deny|unban|unallow)
            [ "$REQUEST_METHOD" = "POST" ] || method_not_allowed
            ;;
    esac
fi

case "$ACTION" in
    list) action_list;;
    denylist) action_denylist;;
    allowlist) action_allowlist;;
    approve|deny)
        if [ -n "$IPAPPROVE_SELFTEST" ]; then
            [ $# -ge 1 ] || fail "missing ip"
            action_set "$ACTION" "$@"
        else
            [ -n "$IP" ] || fail "missing ip"
            action_set "$ACTION" "$IP"
        fi
        ;;
    unban)
        if [ -n "$IPAPPROVE_SELFTEST" ]; then
            [ $# -ge 1 ] || fail "missing ip"
            action_unban "$@"
        else
            [ -n "$IP" ] || fail "missing ip"
            action_unban "$IP"
        fi
        ;;
    unallow)
        if [ -n "$IPAPPROVE_SELFTEST" ]; then
            [ $# -ge 1 ] || fail "missing ip"
            action_unallow "$@"
        else
            [ -n "$IP" ] || fail "missing ip"
            action_unallow "$IP"
        fi
        ;;
    *) fail "missing action";;
esac
