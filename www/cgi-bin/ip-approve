#!/bin/sh
# /www/cgi-bin/ip-approve — IP 审批接口（复用 LuCI 会话鉴权）
# 用法1（CLI 自测，控制器调用，支持批量）：
#   IPAPPROVE_SELFTEST=1 本脚本 approve ip1 [ip2 ...]
# 用法2（HTTP GET 兼容，单个）：?action=list|approve|deny&ip=<地址>
# 自测模式跳过鉴权；LuCI 控制器负责会话校验与参数校验

CN=/etc/ip-approve
PIDF_LOCK=/tmp/.pending.lock
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

json_out() {
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s' "$1"
}

fail() { json_out "{\"ok\":false,\"error\":\"$1\"}"; exit 0; }

# 字符串进 JSON 前转义反斜杠与双引号
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# 写动作仅限 POST：GET 触发返回 405，避免跨站简单请求 CSRF
method_not_allowed() {
    printf 'Status: 405 Method Not Allowed\r\nContent-Type: application/json\r\nAllow: POST\r\nCache-Control: no-store\r\n\r\n{"ok":false,"error":"method-not-allowed"}'
    exit 0
}

# ---- 鉴权（HTTP 模式才走）----
check_auth() {
    local sid out
    sid=$(printf '%s' "$HTTP_COOKIE" | tr ';' '\n' | sed -n 's/^ *sysauth=\([^ ;]*\).*/\1/p')
    [ -n "$sid" ] || return 1
    ubus call session get "{\"ubus_rpc_session\":\"$sid\"}" >/dev/null 2>&1
}

# ---- IP 校验 ----
valid_ip4() {
    echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
    local o; for o in $(echo "$1" | tr '.' ' '); do [ "$o" -le 255 ] 2>/dev/null || return 1; done
}
valid_ip6() {
    echo "$1" | grep -qE '^([0-9a-fA-F]{0,4}:){1,7}[0-9a-fA-F:.]{1,4}$' || return 1
}
# 名单条目：纯 IP 或 CIDR 网段（deny.list 里既有 223.104.195.18 也有 5.231.242.0/24）
valid_entry() {
    case "$1" in
        */*)
            local addr="${1%/*}" prefix="${1##*/}"
            echo "$prefix" | grep -qE '^[0-9]+$' || return 1
            case "$addr" in
                *:*) valid_ip6 "$addr" || return 1; [ "$prefix" -le 128 ] 2>/dev/null || return 1;;
                *)   valid_ip4 "$addr" || return 1; [ "$prefix" -le 32 ] 2>/dev/null || return 1;;
            esac;;
        *:*) valid_ip6 "$1" || return 1;;
        *)   valid_ip4 "$1" || return 1;;
    esac
}

# ---- 失败明细（JSON 拼接）----
FAILED_JSON="["
FAILED_N=0
fail_add() {  # $1=ip $2=error
    [ $FAILED_N = 0 ] || FAILED_JSON="$FAILED_JSON,"
    FAILED_JSON="$FAILED_JSON{\"ip\":\"$1\",\"error\":\"$2\"}"
    FAILED_N=$((FAILED_N+1))
}

# ---- 动作 ----
action_list() {
    local rows="[" first=1 ip a b c rest ts port geo
    # pending.list 行格式：ip 日期 钟点 端口 [归属地]（时间含空格；归属地在端口之后，可含空格）
    while read -r ip a b c rest; do
        [ -n "$ip" ] || continue
        ts="$a $b"
        port="$c"
        case "$port" in *[!0-9]*|'') port="-";; esac
        geo="$rest"
        [ $first = 1 ] && first=0 || rows="$rows,"
        rows="$rows{\"ip\":\"$ip\",\"time\":\"$ts\",\"port\":\"$port\",\"geo\":\"$(json_escape "$geo")\"}"
    done < "$CN/pending.list"
    rows="$rows]"
    json_out "{\"ok\":true,\"rows\":$rows}"
    exit 0
}

# 通用名单读取：$1=v4 文件 $2=v6 文件；注释 `# <ip> <geo>` 关联归属地，
# 文件头独立注释不计入；结果拼到外层 rows / first 变量
read_namelist() {
    local f4="$1" f6="$2" fam f line cur_ip cur_geo
    for fam in v4 v6; do
        [ "$fam" = v4 ] && f="$f4" || f="$f6"
        cur_ip=""; cur_geo=""
        flush_row() {
            [ -n "$cur_ip" ] || return 0
            [ $first = 1 ] && first=0 || rows="$rows,"
            rows="$rows{\"ip\":\"$cur_ip\",\"family\":\"$fam\",\"geo\":\"$(json_escape "$cur_geo")\"}"
            cur_ip=""; cur_geo=""
        }
        while read -r line; do
            [ -n "$line" ] || continue
            case "$line" in
                \#*|';'*)
                    if [ -n "$cur_ip" ]; then
                        # 去掉前导 # 后，仅当首字段是合法条目才视为 `# <ip> <geo>` 注释；
                        # 否则是文件头/分组注释（如 # lan），保留已有归属地不覆盖
                        rest=${line#\#}; rest=${rest# }
                        set -- $rest
                        if [ $# -ge 1 ] && valid_entry "$1"; then
                            shift
                            cur_geo=$*
                        fi
                    fi
                    ;;
                *) flush_row; cur_ip="$line" ;;
            esac
        done < "$f" 2>/dev/null
        flush_row
    done
}

# 黑名单列表：读 ip-deny.list(v4) + ip-deny6.list(v6)
action_denylist() {
    local rows="[" first=1
    read_namelist "$CN/ip-deny.list" "$CN/ip-deny6.list"
    rows="$rows]"
    json_out "{\"ok\":true,\"rows\":$rows}"
    exit 0
}

# 白名单列表：读 ip-allow.list(v4) + ip-allow6.list(v6)
action_allowlist() {
    local rows="[" first=1
    read_namelist "$CN/ip-allow.list" "$CN/ip-allow6.list"
    rows="$rows]"
    json_out "{\"ok\":true,\"rows\":$rows}"
    exit 0
}

# 通用名单移除（支持批量）：入口已吃掉 action，参数为 IP/CIDR 列表。
# 调用前设置全局：RM_F4/RM_F6 名单文件，RM_SET4/RM_SET6 nft 集合，RM_MISS 未命中错误码，RM_ACT 动作名
action_remove() {
    local ok4="" ok6="" ip
    for ip in "$@"; do
        case "$ip" in
            *:*) if valid_entry "$ip"; then ok6="$ok6 $ip"; else fail_add "$ip" "bad-entry"; fi;;
            *)   if valid_entry "$ip"; then ok4="$ok4 $ip"; else fail_add "$ip" "bad-entry"; fi;;
        esac
    done
    local okips="${ok4# }"
    [ -n "${ok6# }" ] && okips="${okips:+$okips }${ok6# }"
    [ -n "$okips" ] || fail "no-valid-entry"

    # flock 内原子更新两份名单；记录实际命中的条目
    rm -f /tmp/.ipap.rm.done /tmp/.ipap.rm.lockrc
    (
        flock -n 9 || exit 1
        : > /tmp/.ipap.rm.done
        for ip in $ok4; do
            grep -qxF "$ip" "$RM_F4" 2>/dev/null || continue
            echo "$ip" >> /tmp/.ipap.rm.done
            # 同时删正文行与对应的 `# <ip> <geo>` 注释行
            awk -v ip="$ip" '$1 == ip { next } /^#/ && $2 == ip { next } { print }' \
                "$RM_F4" > /tmp/.rm4.new 2>/dev/null
            mv /tmp/.rm4.new "$RM_F4"
        done
        for ip in $ok6; do
            grep -qxF "$ip" "$RM_F6" 2>/dev/null || continue
            echo "$ip" >> /tmp/.ipap.rm.done
            awk -v ip="$ip" '$1 == ip { next } /^#/ && $2 == ip { next } { print }' \
                "$RM_F6" > /tmp/.rm6.new 2>/dev/null
            mv /tmp/.rm6.new "$RM_F6"
        done
        echo ok > /tmp/.ipap.rm.lockrc
    ) 9>"$PIDF_LOCK"

    [ -f /tmp/.ipap.rm.lockrc ] || fail "op-failed"
    rm -f /tmp/.ipap.rm.lockrc

    # 未命中的报对应错误码
    local done_ips="" h4="" h6=""
    for ip in $(cat /tmp/.ipap.rm.done 2>/dev/null); do done_ips="$done_ips $ip"; done
    done_ips="${done_ips# }"
    for ip in $okips; do
        case " $done_ips " in
            *" $ip "*) ;;
            *) fail_add "$ip" "$RM_MISS";;
        esac
    done
    for ip in $done_ips; do
        case "$ip" in
            *:*) h6="${h6:+$h6, }$ip";;
            *)   h4="${h4:+$h4, }$ip";;
        esac
    done

    # 即时从 nft set 删元素，再后台同步文件与集合
    [ -n "$h4" ] && nft delete element inet fw4 "$RM_SET4" "{ $h4 }" >/dev/null 2>&1
    [ -n "$h6" ] && nft delete element inet fw4 "$RM_SET6" "{ $h6 }" >/dev/null 2>&1
    ( fw4 reload-sets >/dev/null 2>&1 & )

    local dj="[" df=1
    for ip in $done_ips; do [ $df = 1 ] && df=0 || dj="$dj,"; dj="$dj\"$ip\""; done
    dj="$dj]"
    FAILED_JSON="$FAILED_JSON]"
    json_out "{\"ok\":true,\"action\":\"$RM_ACT\",\"done\":$dj,\"failed\":$FAILED_JSON}"
    exit 0
}

# 从黑名单移除
action_unban() {
    RM_F4="$CN/ip-deny.list";  RM_F6="$CN/ip-deny6.list"
    RM_SET4=ip_deny;           RM_SET6=ip_deny6
    RM_MISS=not-in-denylist;   RM_ACT=unban
    action_remove "$@"
}

# 从白名单移除
action_unallow() {
    RM_F4="$CN/ip-allow.list";  RM_F6="$CN/ip-allow6.list"
    RM_SET4=ip_allow;          RM_SET6=ip_allow6
    RM_MISS=not-in-allowlist;  RM_ACT=unallow
    action_remove "$@"
}

# 审批/拒绝（支持批量）：$1=approve|deny，其余为 IP
action_set() {
    local act="$1"; shift
    local base listfile listfile6
    case "$act" in
        approve) base="ip_allow"; listfile="$CN/ip-allow.list";  listfile6="$CN/ip-allow6.list";;
        deny)    base="ip_deny";  listfile="$CN/ip-deny.list";   listfile6="$CN/ip-deny6.list";;
        *) fail "bad action";;
    esac

    # 1. 校验并按 v4/v6 分类
    local ok4="" ok6="" ip
    for ip in "$@"; do
        case "$ip" in
            *:*) if valid_ip6 "$ip"; then ok6="$ok6 $ip"; else fail_add "$ip" "bad-ip"; fi;;
            *)   if valid_ip4 "$ip"; then ok4="$ok4 $ip"; else fail_add "$ip" "bad-ip"; fi;;
        esac
    done
    local okips="${ok4# }"
    [ -n "${ok6# }" ] && okips="${okips:+$okips }${ok6# }"
    [ -n "$okips" ] || fail "no-valid-ip"

    # 2. flock 内原子更新底账：从 pending.list 移除命中的，记录 done/miss
    rm -f /tmp/.ipap.done /tmp/.ipap.geo /tmp/.ipap.lockrc
    (
        flock -n 9 || exit 1
        : > /tmp/.ipap.done
        : > /tmp/.ipap.geo
        awk -v ok="$okips" '
            BEGIN{n=split(ok,tmp," ");for(i=1;i<=n;i++)ex[tmp[i]]=1}
            $1 in ex {
                print $1 > "/tmp/.ipap.done"
                geo=""
                for(i=5;i<=NF;i++) geo=(geo==""?$i:geo" "$i)
                print $1"\t"geo > "/tmp/.ipap.geo"
                next
            }
            { print }
        ' "$CN/pending.list" > /tmp/.pending.new
        mv /tmp/.pending.new "$CN/pending.list"
        # 写入名单：纯 IP 一行；归属地以 `# <ip> <geo>` 注释行紧随其后（loadfile 与列表展示均跳过注释）
        for ip in $ok4; do
            grep -qxF "$ip" "$listfile" 2>/dev/null && continue
            echo "$ip" >> "$listfile"
            g=$(awk -v ip="$ip" '$1==ip{sub(/^[^\t]*\t/,"");print}' /tmp/.ipap.geo 2>/dev/null)
            [ -n "$g" ] && echo "# $ip $g" >> "$listfile"
        done
        for ip in $ok6; do
            grep -qxF "$ip" "$listfile6" 2>/dev/null && continue
            echo "$ip" >> "$listfile6"
            g=$(awk -v ip="$ip" '$1==ip{sub(/^[^\t]*\t/,"");print}' /tmp/.ipap.geo 2>/dev/null)
            [ -n "$g" ] && echo "# $ip $g" >> "$listfile6"
        done
        echo ok > /tmp/.ipap.lockrc
    ) 9>"$PIDF_LOCK"

    [ -f /tmp/.ipap.lockrc ] || fail "op-failed"
    rm -f /tmp/.ipap.lockrc

    # 3. 区分成功/未命中
    local done_ips="" e4="" e6="" p4="" p6=""
    for ip in $(cat /tmp/.ipap.done 2>/dev/null); do done_ips="$done_ips $ip"; done
    done_ips="${done_ips# }"
    for ip in $okips; do
        case " $done_ips " in
            *" $ip "*) ;;
            *) fail_add "$ip" "not-in-pending";;
        esac
    done
    for ip in $done_ips; do
        case "$ip" in
            *:*) e6="${e6:+$e6, }$ip"; p6="${p6:+$p6, }$ip";;
            *)   e4="${e4:+$e4, }$ip"; p4="${p4:+$p4, }$ip";;
        esac
    done

    # 4. 即时生效：整批一次 nft；fw4 reload-sets 放后台同步文件与集合
    [ -n "$e4" ] && nft add element inet fw4 "$base"      "{ $e4 }" >/dev/null 2>&1
    [ -n "$e6" ] && nft add element inet fw4 "${base}6"   "{ $e6 }" >/dev/null 2>&1
    [ -n "$p4" ] && nft delete element inet fw4 ip_pending  "{ $p4 }" >/dev/null 2>&1
    [ -n "$p6" ] && nft delete element inet fw4 ip_pending6 "{ $p6 }" >/dev/null 2>&1
    ( fw4 reload-sets >/dev/null 2>&1 & )

    # 5. 输出结果
    local dj="[" df=1
    for ip in $done_ips; do [ $df = 1 ] && df=0 || dj="$dj,"; dj="$dj\"$ip\""; done
    dj="$dj]"
    FAILED_JSON="$FAILED_JSON]"
    json_out "{\"ok\":true,\"action\":\"$act\",\"done\":$dj,\"failed\":$FAILED_JSON}"
    exit 0
}

# ---- 入口 ----
if [ -n "$IPAPPROVE_SELFTEST" ]; then
    ACTION="$1"; shift
else
    case "$REQUEST_METHOD" in
        GET|POST) ;;
        *) fail "bad method";;
    esac
    check_auth || fail "unauthorized"
    ACTION=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*action=\([a-z]*\).*/\1/p')
    IP=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*[?&]ip=\([0-9a-fA-F:.]*\).*/\1/p')
    # list/denylist/allowlist 为只读可走 GET；approve/deny/unban/unallow 为写动作，仅允许 POST
    case "$ACTION" in
        approve|deny|unban|unallow)
            [ "$REQUEST_METHOD" = "POST" ] || method_not_allowed
            ;;
    esac
fi

case "$ACTION" in
    list) action_list;;
    denylist) action_denylist;;
    allowlist) action_allowlist;;
    approve|deny)
        if [ -n "$IPAPPROVE_SELFTEST" ]; then
            [ $# -ge 1 ] || fail "missing ip"
            action_set "$ACTION" "$@"
        else
            [ -n "$IP" ] || fail "missing ip"
            action_set "$ACTION" "$IP"
        fi
        ;;
    unban)
        if [ -n "$IPAPPROVE_SELFTEST" ]; then
            [ $# -ge 1 ] || fail "missing ip"
            action_unban "$@"
        else
            [ -n "$IP" ] || fail "missing ip"
            action_unban "$IP"
        fi
        ;;
    unallow)
        if [ -n "$IPAPPROVE_SELFTEST" ]; then
            [ $# -ge 1 ] || fail "missing ip"
            action_unallow "$@"
        else
            [ -n "$IP" ] || fail "missing ip"
            action_unallow "$IP"
        fi
        ;;
    *) fail "missing action";;
esac
